{
  "name": "@copium/agent-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "listen": "node --import tsx src/listen.ts",
    "execute-officer": "node --import tsx src/cli.ts execute-officer",
    "create-agent": "node --import tsx src/cli.ts create-agent"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.24",
    "@copium/config": "workspace:*",
    "@copium/db": "workspace:*",
    "@copium/pulse-engine": "workspace:*",
    "@copium/pulses-client": "workspace:*",
    "@copium/txline": "workspace:*",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "ai": "^4.3.19",
    "dotenv": "^16.5.0",
    "ioredis": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
