{
  "name": "@copium/pulse-orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build-session": "node --import tsx src/cli.ts build-session",
    "advance": "node --import tsx src/cli.ts advance",
    "listen": "node --import tsx src/listen.ts"
  },
  "dependencies": {
    "@copium/db": "workspace:*",
    "@copium/pulse-engine": "workspace:*",
    "@copium/pulses-client": "workspace:*",
    "@copium/settlement": "workspace:*",
    "@copium/txline": "workspace:*",
    "dotenv": "^16.5.0",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
