# copium.fun — devnet defaults (AGILE-PLAN §17, TxLINE Program Addresses doc)
# https://txline-docs.txodds.com/documentation/programs/addresses

COPIUM_NETWORK=devnet

SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Mobile — point at web API (local or Vercel)
# EXPO_PUBLIC_WEB_URL=http://127.0.0.1:3000

TXLINE_API_BASE=https://txline-dev.txodds.com
TXLINE_API_HOST=https://txline-dev.txodds.com/api/
TXLINE_GUEST_AUTH=https://txline-dev.txodds.com/auth/guest/start
# Locked: World Cup free tier only — service level 1 (60s delay, WC + Int Friendlies)
# https://txline.txodds.com/documentation/worldcup
# Do not set TXLINE_SUBSCRIPTION_TIER to paid tiers (2–11). Devnet matrix has only row 1.
# Path to devnet service wallet (defaults: service-wallet.json → ANCHOR_WALLET → ~/.config/solana/id.json)
# TXLINE_SERVICE_WALLET=service-wallet.json
# Set after `pnpm txline:subscribe` activates API access
# TXLINE_API_TOKEN=

# D4 ingest — Redis pub/sub for odds/scores/events
REDIS_URL=redis://127.0.0.1:6379
TXLINE_INGEST_PORT=9090
PULSE_ORCHESTRATOR_PORT=9091
AGENT_RUNTIME_PORT=9093

TXORACLE_PROGRAM_ID=6pW64gN1s2uqjHkn1unFeEjAwJkPGHoppGvS715wyP2J
TXL_TOKEN_MINT=4Zao8ocPhmMgq7PdsYWyxvqySMGx7xb9cMftPMkEokRG
USDT_MINT=ELWTKspHKCnCfCiCiqYw1EDH77k8VCP74dK9qytG2Ujh

# Supabase — Project Settings → API + Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI for `pnpm db:migrate` (Database → Connection string)
DATABASE_URL=

# Spawner + Narrator (D15+)
# OPENAI_API_KEY=

# Anchor copium-pulses (D1) — `pnpm anchor:build`
# ANCHOR_WALLET=~/.config/solana/id.json
